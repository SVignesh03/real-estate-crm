// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  ADMIN
  SALES_REP
}

enum ProjectStatus {
  PLANNING
  UNDER_CONSTRUCTION
  COMPLETED
}

enum UnitType {
  STUDIO
  ONE_BHK
  TWO_BHK
  THREE_BHK
  PENTHOUSE
}

enum UnitStatus {
  AVAILABLE
  BOOKED
  BLOCKED
  SOLD
}

enum LeadStage {
  NEW
  CONTACTED
  SITE_VISIT
  INTERESTED
  NEGOTIATION
  BOOKED
  LOST
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  PENDING
}

// ----------------------------------------------------
// MODELS
// ----------------------------------------------------

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  password      String
  name          String
  role          Role       @default(SALES_REP)
  assignedLeads Lead[]     @relation("AssignedLeads")
  notes         LeadNote[]
  bookings      Booking[]  @relation("BookedByUser")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([role])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  location    String
  status      ProjectStatus @default(UNDER_CONSTRUCTION)
  buildings   Building[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Building {
  id        String   @id @default(cuid())
  name      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  floors    Int      @default(1)
  units     Unit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Unit {
  id              String      @id @default(cuid())
  unitNumber      String
  buildingId      String
  building        Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floor           Int
  type            UnitType
  areaSqFt        Float
  price           Decimal     @db.Decimal(12, 2)
  status          UnitStatus  @default(AVAILABLE)
  booking         Booking?
  interestedLeads Lead[]      @relation("InterestedUnit")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([buildingId, unitNumber])
  @@index([buildingId])
  @@index([status])
}

model Lead {
  id               String     @id @default(cuid())
  name             String
  email            String
  phone            String
  source           String     @default("WEBSITE")
  stage            LeadStage  @default(NEW)
  budget           Decimal?   @db.Decimal(12, 2)
  assignedToId     String?
  assignedTo       User?      @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  interestedUnitId String?
  interestedUnit   Unit?      @relation("InterestedUnit", fields: [interestedUnitId], references: [id], onDelete: SetNull)
  notes            LeadNote[]
  bookings         Booking[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([assignedToId])
  @@index([stage])
}

model LeadNote {
  id               String    @id @default(cuid())
  leadId           String
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId         String
  author           User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content          String
  nextFollowUpDate DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([leadId])
  @@index([nextFollowUpDate])
}

model Booking {
  id            String        @id @default(cuid())
  bookingNumber String        @unique
  unitId        String        @unique
  unit          Unit          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  leadId        String
  lead          Lead          @relation(fields: [leadId], references: [id], onDelete: Restrict)
  bookedById    String
  bookedBy      User          @relation("BookedByUser", fields: [bookedById], references: [id], onDelete: Restrict)
  bookingAmount Decimal       @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  status        BookingStatus @default(CONFIRMED)
  notes         String?
  bookingDate   DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([leadId])
  @@index([bookedById])
  @@index([status])
}
